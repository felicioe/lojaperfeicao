# Copie para .env localmente, ou configure estas mesmas chaves como
# variáveis de ambiente no painel Node.js da Hostinger (hPanel). Nunca
# commitar um arquivo .env com valores reais — veja .gitignore.

# ---------- MySQL (Hostinger) ----------
# Host do MySQL da hospedagem (geralmente "localhost" quando o Node.js e
# o MySQL estão na mesma conta Hostinger).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Máximo de conexões simultâneas no pool. Hospedagem compartilhada tem um
# limite baixo de conexões MySQL concorrentes (verifique em hPanel > Bancos
# de dados MySQL — normalmente algo entre 5 e 25 no total, dividido entre
# todos os processos/apps que usam o mesmo banco). Comece conservador;
# aumentar depois é seguro, diminuir sob carga real não é. Ver mysql/README.md,
# seção 14.
MYSQL_CONNECTION_LIMIT=5

# ---------- Sessão ----------
# String aleatória de pelo menos 32 caracteres, usada para assinar o cookie
# de sessão. Gere uma nova para produção (nunca reaproveitar a de dev/local):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Ambiente ----------
# Em produção, habilita o cookie de sessão com o flag "secure" (exige HTTPS).
NODE_ENV=production

# ---------- Notificações push (issue #27) ----------
# Par de chaves VAPID para Web Push — gere um par por instalação com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY é enviada ao navegador (não é segredo); VAPID_PRIVATE_KEY
# nunca deve ser exposta ao cliente nem commitada.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# E-mail de contato exigido pelo protocolo Web Push (formato mailto:).
VAPID_CONTACT_EMAIL=mailto:contato@example.com

# Token que protege o endpoint /api/cron/notificacoes (disparo periódico de
# push). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configure um cron job no hPanel para chamar, por exemplo 1x/dia:
#   curl "https://SEU_DOMINIO/api/cron/notificacoes?token=SEU_CRON_SECRET"
CRON_SECRET=

# ---------- Passkeys (WebAuthn — Face ID/Touch ID/Windows Hello) ----------
# Domínio do site em produção, SEM protocolo nem porta (ex.:
# sistema.associacaoadonhiramita.org). Se não configurado, cai em
# "localhost" — só funciona em dev local.
WEBAUTHN_RP_ID=
# URL completa do site em produção, COM protocolo e sem barra no final
# (ex.: https://sistema.associacaoadonhiramita.org).
PUBLIC_ORIGIN=
