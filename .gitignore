# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Segredos de ambiente — nunca versionar (MYSQL_PASSWORD, SESSION_SECRET
# etc.). Use .env.example como referência do que precisa ser configurado.
.env
.env.*
!.env.example

# Arquivos enviados por usuários em runtime (foto de irmão, logo de corpo,
# peças de arquitetura...) — gravados em disco pela própria aplicação
# (ver src/lib/backend/*.ts, funções de upload), nunca fazem parte do código.
public/uploads/

# Backups completos gerados pelo cron/UI de administração (issue #85) —
# nunca em public/ (teriam senha_hash, secrets de 2FA/passkey etc.) e
# nunca versionados, são dados de runtime.
/backups/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
